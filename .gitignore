# ==========================================
# Kotlin Multiplatform (Android + iOS) .gitignore
# ==========================================

# ------------------------------------------
# Gradle & Build Outputs
# ------------------------------------------
.gradle/
build/
**/build/
!src/**/build/
.gradletasknamecache

# Android Build Outputs
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# iOS Build Outputs & Debug Symbols
*.app
*.ipa
*.dSYM
*.dSYM.zip

# ------------------------------------------
# Kotlin & Kotlin Multiplatform
# ------------------------------------------
.kotlin/
.konan/
kotlin-js-store/

# ------------------------------------------
# Android & Native Build Artifacts
# ------------------------------------------
captures/
.externalNativeBuild/
.cxx/
*.hprof

# ------------------------------------------
# Xcode / iOS
# ------------------------------------------
xcuserdata/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
*.xcworkspace/*
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
Pods/
.swiftpm/

# ------------------------------------------
# IDE & Editor Settings
# ------------------------------------------
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.navigation/
.artifacts/

# Other Editors
.vscode/
.fleet/
.zed/

# ------------------------------------------
# Secrets, Keys & Signing Files
# ------------------------------------------
local.properties
secret.properties
secrets.properties
*.jks
*.keystore
*.key
*.pem
*.p12
*.mobileprovision
*.cer

# ------------------------------------------
# OS & System Specific
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# Web & Miscellaneous
# ------------------------------------------
node_modules/
*.log
*.swp
*~
*.bak
